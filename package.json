{
  "name": "@jokio/rpc",
  "version": "1.7.0",
  "description": "Type-safe RPC framework with Zod validation for Express and TypeScript",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "prettier": {
    "semi": false
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build",
    "test": "vitest run"
  },
  "keywords": [
    "rpc",
    "typescript",
    "zod",
    "express",
    "type-safe",
    "api",
    "validation",
    "framework"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.10.0",
    "@types/supertest": "^7.2.0",
    "express": "^5.2.1",
    "supertest": "^7.2.2",
    "tsup": "^8.0.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5",
    "zod": "^4.3.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jokio/rpc.git"
  },
  "bugs": {
    "url": "https://github.com/jokio/rpc/issues"
  },
  "homepage": "https://github.com/jokio/rpc#readme",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.17.0",
  "publishConfig": {
    "access": "public"
  },
  "allowScripts": {
    "esbuild@0.27.2": true,
    "fsevents@2.3.3": true
  }
}
